{
  "name": "ksp-sentinel",
  "version": "1.0.0",
  "description": "KSP Sentinel - AI-Powered Crime Intelligence & Predictive Analytics Platform",
  "scripts": {
    "frontend:install": "cd frontend && npm install",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "backend:install": ".venv\\Scripts\\pip.exe install -r requirements.txt",
    "backend:dev": ".venv\\Scripts\\python.exe -m uvicorn backend.app.main:app --reload --host 0.0.0.0 --port 8000",
    "celery:worker": ".venv\\Scripts\\celery.exe -A celery.worker worker --loglevel=info",
    "celery:beat": ".venv\\Scripts\\celery.exe -A celery.worker beat --loglevel=info",
    "install-all": "npm run frontend:install && npm run backend:install",
    "dev": "npx concurrently \"npm run backend:dev\" \"npm run frontend:dev\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
