# General
ENVIRONMENT=development
SECRET_KEY=ksp_sentinel_super_secret_cryptographic_key_2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ksp_sentinel
# Fallback SQLite DB path inside workspace if PostgreSQL is not active
SQLITE_URL=sqlite:///./ksp_sentinel.db

# Caching & Background Workers
REDIS_URL=redis://localhost:6379/0

# AI Configuration
# IMPORTANT: Do NOT paste real API keys in chat, issue trackers, or public places.
# If a key was shared accidentally, rotate it immediately at the provider.
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Security Settings
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Catalyst FileStore (data source for /api/reviews via backend/app/filestore_data.py)
# STORAGE_PROVIDER=catalyst also routes core/storage.py uploads to Catalyst; the reviews
# loader initializes the SDK on its own and only needs the folder id below.
STORAGE_PROVIDER=local
# Id of the `ksp` FileStore folder holding the CRIME_REVIEW_*.csv files.
CATALYST_FOLDER_ID=48446000000036421
