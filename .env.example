# ─────────────────────────────────────────────────────────────────────────────
# KSP Sentinel — environment template
#
# Copy to .env and fill in what you need:      cp .env.example .env
# .env is gitignored; this template is not, so NEVER put a real value here.
#
# Nothing below is required to run the project. Every entry has a working
# fallback — the app boots and all features respond without any of them.
# ─────────────────────────────────────────────────────────────────────────────


# ── 1. SECURITY — set these before any real deployment ───────────────────────

# Signs every JWT AND keys the HMAC that protects complainant phone numbers.
# The built-in default is visible in the source, so anyone reading the repo can
# forge admin tokens. Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# WARNING: rotating this invalidates all sessions AND makes every already-stored
# complainant phone hash unverifiable (the numbers themselves were never stored,
# so they cannot be re-derived). Set it before registering real contacts.
SECRET_KEY=

# Fernet key encrypting TOTP/MFA secrets at rest. Leave BLANK — it is generated
# on first startup and appended to .env automatically. Do not lose it: losing it
# permanently strands every enrolled MFA user.
TOTP_ENCRYPTION_KEY=


# ── 2. AI COPILOT (optional) ─────────────────────────────────────────────────
#
# Selects the model behind the Copilot's free-form answers. Structured questions
# ("thefts in Bengaluru last month") are answered by the local SQL compiler and
# work with NO key at all — a key only unlocks open-ended questions.
#
# LLM_PROVIDER: auto | groq | gemini | ollama | none
#   auto  = use whichever key is present (Groq preferred, then Gemini)
#   none  = disable free-form answers entirely
LLM_PROVIDER=groq

# Groq — free tier, no card required.  Key: https://console.groq.com/keys
GROQ_API_KEY=
# Groq retires models faster than most; if a call starts failing, check
# https://console.groq.com/docs/models and update this name.
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini — alternative. Key: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# Ollama — local inference. No key, and no crime data leaves the machine;
# the option to reach for if data may not cross jurisdictions.
# Install from https://ollama.com, then:  ollama pull llama3
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3


# ── 3. INFRASTRUCTURE (optional) ─────────────────────────────────────────────

# Without Redis: rate limiting and brute-force bans fall back to in-memory
# (single-process only, cleared on restart). Celery REQUIRES it as a broker for
# the nightly MO-matching and nudge jobs.
REDIS_URL=redis://localhost:6379/0

# sqlite (default) or a PostgreSQL DSN.
# DATABASE_URL=
# SQLITE_URL=sqlite:///./ksp_sentinel.db

# Comma-separated. Defaults to a localhost + *.onslate.in / *.catalystserverless.in allow-list.
# ALLOWED_ORIGINS=


# ── 4. ZOHO CATALYST (optional — cloud storage + datastore sync) ─────────────
# Console: https://console.catalyst.zoho.in/   (note the .in — India data centre)
# Leave STORAGE_PROVIDER=local to keep everything on disk.

STORAGE_PROVIDER=local
# CATALYST_AUTH_TOKEN=
# CATALYST_ORG_ID=
# CATALYST_FOLDER_ID=
# CATALYST_STRATUS_BUCKET=


# ── 5. MESSAGING (optional — Feature 5 is stubbed) ───────────────────────────
# "stub" logs the message instead of sending it and flags every result
# simulated=true. The other providers are scaffolded but NOT implemented — see
# the TODO blocks in backend/integrations/messaging_bot.py.
#   twilio          https://console.twilio.com/
#   gupshup         https://www.gupshup.io/developer/home
#   whatsapp_cloud  https://developers.facebook.com/docs/whatsapp/cloud-api/get-started

MESSAGING_PROVIDER=stub
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# GUPSHUP_API_KEY=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=


# ── 6. TUNING (optional — all have sensible defaults) ────────────────────────
# DUPLICATE_SIMILARITY_THRESHOLD=0.85
# MO_MATCH_THRESHOLD=0.75
# NUDGE_STALENESS_DAYS=14
# NUDGE_CHARGESHEET_DEADLINE_DAYS=60
# SAFETY_DEFAULT_RADIUS_M=300
# FIR_STATUS_RATE_LIMIT=10/minute
